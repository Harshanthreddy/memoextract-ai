# .gitignore

# Environment / secrets
.env
.env.local
.env.*
!.env.example          # ← this is the exception we want

# Python / virtual env
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# Deployment / temp files
*.log
.DS_Store

# Node / Next.js
node_modules/
.next/
web/node_modules/
web/.next/

# SQLite databases & temp generated files
*.db
*.sqlite
*.sqlite3
extracted_marksheet.xlsx

